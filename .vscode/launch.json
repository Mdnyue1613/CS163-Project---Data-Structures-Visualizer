{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Raylib",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/main",
            "cwd": "${workspaceFolder}",
            "MIMode": "lldb",
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build",
            "externalConsole": false,
            "stopAtEntry": false
        }
    ]
}
