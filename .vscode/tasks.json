{
    "version": "2.0.0", // Number of version
    "tasks": [
        {
            "label": "Build Visualizer", // Name of building tasks
            "type": "shell", // Type of terminal
            "command": "g++", // Compiler
            "args": [
                "./src/*.cpp", // File being compiled
                "-o", "./bin/game", // Name of the resultant program
                "-I", "./include", // Directory of include folder
                "-L", "./lib", // Directory of lib folder
                "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm" // Libraries from raylib
            ],
            "group": { "kind": "build", "isDefault": true } // Default build
        }
    ]
}
